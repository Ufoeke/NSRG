    {
      "name": "Integration Tests",
      "description": "End-to-end integration test scenarios",
      "item": [
        {
          "name": "Complete SSID Deployment Workflow",
          "description": "Test the complete workflow from security profile creation to SSID deployment",
          "item": [
            {
              "name": "1. Create Security Profile",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Integration-Test-WPA2\",\n  \"authType\": \"wpa2_psk\",\n  \"encryption\": \"aes\",\n  \"passphrase\": \"IntegrationTest123!\",\n  \"description\": \"Security profile for integration testing\"\n}"
                },
