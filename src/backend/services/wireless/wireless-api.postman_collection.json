  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Set up any pre-request logic here",
          "// For example, generate timestamps or request IDs",
          "pm.request.headers.add({",
          "    key: 'X-Request-ID',",
          "    value: pm.variables.replaceIn('{{$randomUUID}}'),",
          "});",
          "",
          "// Set timestamp for request tracking",
          "pm.environment.set('requestTimestamp', new Date().toISOString());"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test assertions",
          "pm.test('Response time is acceptable', function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(5000);",
          "});",
          "",
          "pm.test('Response has proper headers', function () {",
          "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
          "});",
          "",
          "// Store response data for use in subsequent requests",
          "if (pm.response.code === 201 && pm.response.json().id) {",
          "    const responseBody = pm.response.json();",
          "    ",
          "    // Store IDs based on request URL",
          "    if (pm.request.url.toString().includes('/ssids')) {",
          "        pm.environment.set('ssid_id', responseBody.id);",
          "    } else if (pm.request.url.toString().includes('/access-points')) {",
          "        pm.environment.set('access_point_id', responseBody.id);",
          "    } else if (pm.request.url.toString().includes('/security-profiles')) {",
          "        pm.environment.set('security_profile_id', responseBody.id);",
          "    }",
          "}"
        ]
      }
    }
  ]
}