{
  "info": {
    "name": "Wireless Service API",
    "description": "Comprehensive API collection for testing wireless service endpoints including SSID management, access point deployment, and security policy configuration.",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/wireless",
      "type": "string"
    },
    {
      "key": "authToken",
      "value": "{{jwt_token}}",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "{{api_key}}",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{authToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "SSID Management",
      "description": "Endpoints for managing wireless SSIDs",
      "item": [
        {
          "name": "List All SSIDs",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ssids?limit=20&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["ssids"],
              "query": [
                {
                  "key": "vendor",
                  "value": "cisco-meraki",
                  "disabled": true
                },
                {
                  "key": "enabled",
                  "value": "true",
                  "disabled": true
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create New SSID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test-Corporate-WiFi\",\n  \"enabled\": true,\n  \"securityProfileId\": \"sec-prof-001\",\n  \"vlanId\": 100,\n  \"bandwidthPolicyId\": \"bw-pol-001\",\n  \"accessPoints\": [\"ap-001\", \"ap-002\"],\n  \"description\": \"Test corporate network for development\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ssids",
              "host": ["{{baseUrl}}"],
              "path": ["ssids"]
            }
          },
          "response": []
        },
        {
          "name": "Get SSID Details",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ssids/ssid-001",
              "host": ["{{baseUrl}}"],
              "path": ["ssids", "ssid-001"]
            }
          },
          "response": []
        },
        {
          "name": "Update SSID",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated-Corporate-WiFi\",\n  \"enabled\": false,\n  \"description\": \"Updated corporate network configuration\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ssids/ssid-001",
              "host": ["{{baseUrl}}"],
              "path": ["ssids", "ssid-001"]
            }
          },
          "response": []
        },
        {
          "name": "Delete SSID",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ssids/ssid-001",
              "host": ["{{baseUrl}}"],
              "path": ["ssids", "ssid-001"]
            }
          },
          "response": []
        },
        {
          "name": "Bulk SSID Operations",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"operation\": \"create\",\n  \"ssids\": [\n    {\n      \"name\": \"Bulk-SSID-1\",\n      \"securityProfileId\": \"sec-prof-001\",\n      \"vlanId\": 101,\n      \"description\": \"First bulk SSID\"\n    },\n    {\n      \"name\": \"Bulk-SSID-2\",\n      \"securityProfileId\": \"sec-prof-002\",\n      \"vlanId\": 102,\n      \"description\": \"Second bulk SSID\"\n    }\n  ],\n  \"options\": {\n    \"continueOnError\": true,\n    \"validateOnly\": false\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ssids/bulk",
              "host": ["{{baseUrl}}"],
              "path": ["ssids", "bulk"]
            }
          },
          "response": []
        }
      ]
    },
