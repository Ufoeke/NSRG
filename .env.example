# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Application
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nsrg_db_dev
DB_USER=nsrg_user
DB_PASSWORD=nsrg_dev_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# ServiceNow Integration
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# Network Device APIs
FORTIGATE_API_KEY=your-fortigate-api-key
CISCO_FMC_USERNAME=your-cisco-username
CISCO_FMC_PASSWORD=your-cisco-password
MERAKI_API_KEY=your-meraki-api-key
PALO_ALTO_API_KEY=your-palo-alto-api-key

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# Security
BCRYPT_ROUNDS=12
CORS_ORIGIN=http://localhost:3000